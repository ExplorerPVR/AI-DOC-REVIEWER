# Database Credentials and Connection String
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc_assistant
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/doc_assistant

# Application Configuration
APP_NAME=AI Document Assistant
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# File Upload Constraints & Storage
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_EXTENSIONS=.pdf,.txt,.docx
UPLOAD_DIR=uploads

# Embedding Provider Configuration ('gemini' or 'ollama')
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# LLM Provider API Keys & Configuration (No API keys committed to code)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_PROVIDER=groq
GROQ_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=3
